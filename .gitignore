# --- General & System Files ---
node_modules/
.DS_Store
*.log
.idea/
.vscode/
npm-debug.*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.eslintcache
*.tsbuildinfo
.qodo/
.jules/

# --- Web & Server Build Artifacts ---
build/
dist/
coverage/
test-results/
playwright-report/

# --- Mobile Specific (Expo & React Native) ---
# Added from your mobile/.gitignore to prevent .expo/ tracking
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/ios/build/
mobile/ios/Pods/
mobile/ios/.xcode.env.local
*.jsc
*.jsbundle
*.map
*.apk
*.aab
*.ipa
*.keystore
*.jks

# --- Environment Variables (Security) ---
# Excludes sensitive keys while keeping examples for other devs
.env*
!.env.example
mobile/.env*
!mobile/.env.example

# --- SQLite Database Files ---
# Essential to prevent leaking patient/attendance data
*.db
*.db-wal
*.db-shm
:memory:
*.sqlite

# --- User Uploads & Media ---
public/uploads/*
!public/uploads/.gitkeep
*.cjs
